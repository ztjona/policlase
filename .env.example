# Copie a .env y complete. Nunca suba .env al repositorio.

# --- obligatorio -----------------------------------------------------------------
DJANGO_SECRET_KEY=cambie-esto-por-50-caracteres-aleatorios
POSTGRES_PASSWORD=cambie-esto-tambien

# --- dominio (cuando lo tenga) ---------------------------------------------------
# Sin dominio, la plataforma responde solo en http://localhost:8100.
POLICLASE_DOMAIN=
POLICLASE_HTTPS=0            # 1 detrás de nginx con certificado
POLICLASE_HSTS_SECONDS=0     # súbalo a 31536000 cuando HTTPS esté estable

# --- correo ----------------------------------------------------------------------
# console: los correos se imprimen en `docker compose logs web` (prototipo)
# smtp:    envío real, con los datos de su proveedor
POLICLASE_EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=policlase <no-responder@example.com>

# --- datos y red -----------------------------------------------------------------
POLICLASE_DATA=/mnt/mydrive/policlase
POLICLASE_PORT=8100
POLICLASE_WORKERS=2
