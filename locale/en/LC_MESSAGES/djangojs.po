#: static/js/activity-present.js:33
msgid "%(n)s de %(total)s estudiantes respondieron esta parte"
msgstr "%(n)s of %(total)s students answered this part"

#: static/js/activity-present.js:43
msgid "Los estudiantes pueden seguir su posición"
msgstr "Students can follow your position"

#: static/js/activity-present.js:47 static/js/live.js:126
#: static/js/studio.js:233
msgid "sin conexión"
msgstr "offline"

#: static/js/activity-teacher.js:72 static/js/activity.js:70
msgid "Guardando…"
msgstr "Saving…"

#: static/js/activity-teacher.js:79
msgid "calificada"
msgstr "graded"

#: static/js/activity-teacher.js:82
msgid "Sin conexión: no se guardó."
msgstr "Offline: not saved."

#: static/js/activity.js:27
msgid "En esta respuesta no está permitido pegar texto."
msgstr "Pasting text is not allowed in this answer."

#: static/js/activity.js:59
msgid ""
"Su sesión se cerró y los últimos cambios no se guardaron. Copie sus "
"respuestas recientes, recargue la página e ingrese de nuevo."
msgstr ""
"Your session ended and your latest changes were not saved. Copy your recent "
"answers, reload the page and sign in again."

#: static/js/activity.js:60
msgid ""
"Este borrador ya no está abierto; es posible que se haya enviado desde otra "
"pestaña. Recargue la página."
msgstr ""
"This draft is no longer open; it may have been submitted from another tab. "
"Reload the page."

#: static/js/activity.js:61
msgid ""
"El servidor no pudo guardar los cambios. Puede seguir escribiendo; se "
"volverá a intentar automáticamente."
msgstr ""
"The server could not save your changes. You can keep writing; it will retry "
"automatically."

#: static/js/activity.js:62
msgid ""
"Sin conexión: no se guardó. Puede seguir escribiendo; se volverá a intentar "
"automáticamente."
msgstr "Offline: not saved. You can keep writing; it will retry automatically."

#: static/js/activity.js:85
#, javascript-format
msgid "Guardado automáticamente a las %s"
msgstr "Saved automatically at %s"

#: static/js/activity.js:149
msgid "Subiendo imagen…"
msgstr "Uploading image…"

#: static/js/activity.js:167
msgid "No se pudo subir la imagen. Revise su conexión e intente de nuevo."
msgstr "The image could not be uploaded. Check your connection and try again."

#: static/js/activity.js:170
msgid "Imagen guardada."
msgstr "Image saved."

#: static/js/activity.js:228
msgid "Sin conexión: no se pudo enviar. Se volverá a intentar automáticamente."
msgstr "Offline: could not be sent. It will retry automatically."

#: static/js/activity.js:290
msgid "Sin conexión: no se pudo comprobar. Inténtelo de nuevo."
msgstr "No connection: it could not be checked. Please try again."

#: static/js/activity.js:367
#, javascript-format
msgid "Queda %s pregunta sin responder, que vale cero."
msgid_plural "Quedan %s preguntas sin responder, que valen cero."
msgstr[0] "%s question is unanswered and is worth zero."
msgstr[1] "%s questions are unanswered and are worth zero."

#: static/js/activity.js:369
#, javascript-format
msgid "%s pregunta está marcada para revisar."
msgid_plural "%s preguntas están marcadas para revisar."
msgstr[0] "%s question is marked for review."
msgstr[1] "%s questions are marked for review."

#: static/js/activity.js:447
msgid "Quedan 10 minutos de evaluación."
msgstr "10 minutes of the assessment remain."

#: static/js/activity.js:447
msgid "Quedan 2 minutos de evaluación."
msgstr "2 minutes of the assessment remain."

#: static/js/activity.js:465
msgid "Se acabó el tiempo. Se está enviando la evaluación…"
msgstr "Time is up. The assessment is being submitted…"

#: static/js/activity.js:513
msgid "el comienzo de la actividad"
msgstr "the beginning of the activity"

#: static/js/debate.js:25
msgid "No se pudo registrar el «me gusta»."
msgstr "The like could not be recorded."

#: static/js/debate.js:30
msgid "Sin conexión. Inténtelo de nuevo."
msgstr "No connection. Please try again."

#: static/js/live.js:122
msgid "Sin acceso a esta clase."
msgstr "No access to this class."

#: static/js/live.js:177
msgid "en vivo"
msgstr "live"

#: static/js/live.js:178
msgid "reconectando…"
msgstr "reconnecting…"

#: static/js/live.js:183
msgid "clase terminada"
msgstr "class ended"

#: static/js/live.js:210
#, javascript-format
msgid "No se pudo aplicar la acción (%s)."
msgstr "Couldn't apply the action (%s)."

#: static/js/live.js:336
msgid "Enviando…"
msgstr "Sending…"

#: static/js/live.js:341
msgid "Enviar respuesta"
msgstr "Submit answer"

#: static/js/live.js:342
msgid "No se pudo enviar. Revise su conexión e intente de nuevo."
msgstr "Couldn't send. Check your connection and try again."

#: static/js/results.js:29
msgid "Nota"
msgstr "Grade"

#: static/js/results.js:31
msgid "Guardar"
msgstr "Save"

#: static/js/results.js:36
msgid "Volver a la nota automática"
msgstr "Back to the automatic grade"

#: static/js/studio.js:194 static/js/studio.js:573
#, javascript-format
msgid "línea %s"
msgstr "line %s"

#: static/js/studio.js:205
msgid "validando…"
msgstr "validating…"

#: static/js/studio.js:223
msgid "sin errores"
msgstr "no errors"

#: static/js/studio.js:228
#, javascript-format
msgid "%s error"
msgid_plural "%s errores"
msgstr[0] "%s error"
msgstr[1] "%s errors"

#: static/js/studio.js:242
msgid "Corrija los errores antes de usar el panel."
msgstr "Fix the errors before using the panel."

#: static/js/studio.js:332
msgid "Título"
msgstr "Title"

#: static/js/studio.js:332
msgid "Texto con matemáticas: $f(x) = x^2$."
msgstr "Text with math: $f(x) = x^2$."

