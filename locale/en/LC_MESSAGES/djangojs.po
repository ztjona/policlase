#: static/js/activity-present.js:33
msgid "%(n)s de %(total)s estudiantes respondieron esta parte"
msgstr "%(n)s of %(total)s students answered this part"

#: static/js/activity-present.js:43
msgid "Los estudiantes pueden seguir su posición"
msgstr "Students can follow your position"

#: static/js/activity-present.js:47 static/js/live.js:123
#: static/js/studio.js:233
msgid "sin conexión"
msgstr "offline"

#: static/js/activity-teacher.js:51
msgid "Buscando las respuestas por calificar…"
msgstr "Looking for answers to grade…"

#: static/js/activity-teacher.js:54
msgid "No hay respuestas que esperen una propuesta."
msgstr "No answers are waiting for a proposal."

#: static/js/activity-teacher.js:56
#, javascript-format
msgid "%s de %s propuestas generadas"
msgstr "%s of %s proposals generated"

#: static/js/activity-teacher.js:57
#, javascript-format
msgid "%s con error"
msgstr "%s with errors"

#: static/js/activity-teacher.js:70
msgid "Listo. Revíselas en «Revisar por pregunta»."
msgstr "Done. Review them in “Review by question”."

#: static/js/activity-teacher.js:74 static/js/activity-teacher.js:100
#: static/js/debate.js:61
msgid "Sin conexión. Inténtelo de nuevo."
msgstr "No connection. Please try again."

#: static/js/activity-teacher.js:83
msgid "Consultando a la IA…"
msgstr "Asking the AI…"

#: static/js/activity-teacher.js:86
msgid "No se pudo generar la propuesta."
msgstr "The proposal could not be generated."

#: static/js/activity-teacher.js:99
msgid "La propuesta está lista. Revise la nota y el comentario, y guárdelos."
msgstr ""
"The proposal is ready. Review the grade and the comment, and save them."

#: static/js/activity-teacher.js:152 static/js/activity.js:111
msgid "Guardando…"
msgstr "Saving…"

#: static/js/activity-teacher.js:159
msgid "calificada"
msgstr "graded"

#: static/js/activity-teacher.js:162
msgid "Sin conexión: no se guardó."
msgstr "Offline: not saved."

#: static/js/activity.js:27
msgid "En esta respuesta no está permitido pegar texto."
msgstr "Pasting text is not allowed in this answer."

#: static/js/activity.js:100
msgid ""
"Su sesión se cerró y los últimos cambios no se guardaron. Copie sus "
"respuestas recientes, recargue la página e ingrese de nuevo."
msgstr ""
"Your session ended and your latest changes were not saved. Copy your recent "
"answers, reload the page and sign in again."

#: static/js/activity.js:101
msgid ""
"Este borrador ya no está abierto; es posible que se haya enviado desde otra "
"pestaña. Recargue la página."
msgstr ""
"This draft is no longer open; it may have been submitted from another tab. "
"Reload the page."

#: static/js/activity.js:102
msgid ""
"El servidor no pudo guardar los cambios. Puede seguir escribiendo; se "
"volverá a intentar automáticamente."
msgstr ""
"The server could not save your changes. You can keep writing; it will retry "
"automatically."

#: static/js/activity.js:103
msgid ""
"Sin conexión: no se guardó. Puede seguir escribiendo; se volverá a intentar "
"automáticamente."
msgstr "Offline: not saved. You can keep writing; it will retry automatically."

#: static/js/activity.js:126
#, javascript-format
msgid "Guardado automáticamente a las %s"
msgstr "Saved automatically at %s"

#: static/js/activity.js:192
msgid "Subiendo imagen…"
msgstr "Uploading image…"

#: static/js/activity.js:210
msgid "No se pudo subir la imagen. Revise su conexión e intente de nuevo."
msgstr "The image could not be uploaded. Check your connection and try again."

#: static/js/activity.js:213
msgid "Imagen guardada."
msgstr "Image saved."

#: static/js/activity.js:271
msgid "Sin conexión: no se pudo enviar. Se volverá a intentar automáticamente."
msgstr "Offline: could not be sent. It will retry automatically."

#: static/js/activity.js:299
msgid ""
"Todavía no ha respondido esta pregunta. Si la cierra ahora, ya no podrá "
"responderla. ¿Cerrarla?"
msgstr ""
"You have not answered this question yet. If you close it now, you will not "
"be able to answer it. Close it?"

#: static/js/activity.js:357
msgid "Sin conexión: no se pudo comprobar. Inténtelo de nuevo."
msgstr "No connection: it could not be checked. Please try again."

#: static/js/activity.js:441
#, javascript-format
msgid "Queda %s pregunta sin responder, que vale cero."
msgid_plural "Quedan %s preguntas sin responder, que valen cero."
msgstr[0] "%s question is unanswered and is worth zero."
msgstr[1] "%s questions are unanswered and are worth zero."

#: static/js/activity.js:443
#, javascript-format
msgid "%s pregunta está marcada para revisar."
msgid_plural "%s preguntas están marcadas para revisar."
msgstr[0] "%s question is marked for review."
msgstr[1] "%s questions are marked for review."

#: static/js/activity.js:481
msgid "Quedan 10 minutos de evaluación."
msgstr "10 minutes of the assessment remain."

#: static/js/activity.js:481
msgid "Quedan 2 minutos de evaluación."
msgstr "2 minutes of the assessment remain."

#: static/js/activity.js:499
msgid "Se acabó el tiempo. Se está enviando la evaluación…"
msgstr "Time is up. The assessment is being submitted…"

#: static/js/activity.js:547
msgid "el comienzo de la actividad"
msgstr "the beginning of the activity"

#: static/js/class-review.js:30
msgid "Diapositiva %(n)s de %(total)s"
msgstr "Slide %(n)s of %(total)s"

#: static/js/debate.js:56
msgid "No se pudo registrar el «me gusta»."
msgstr "The like could not be recorded."

#: static/js/live.js:119
msgid "Sin acceso a esta clase."
msgstr "No access to this class."

#: static/js/live.js:174
msgid "en vivo"
msgstr "live"

#: static/js/live.js:175
msgid "reconectando…"
msgstr "reconnecting…"

#: static/js/live.js:180
msgid "clase terminada"
msgstr "class ended"

#: static/js/live.js:207
#, javascript-format
msgid "No se pudo aplicar la acción (%s)."
msgstr "Couldn't apply the action (%s)."

#: static/js/live.js:333
msgid "Enviando…"
msgstr "Sending…"

#: static/js/live.js:338
msgid "Enviar respuesta"
msgstr "Submit answer"

#: static/js/live.js:339
msgid "No se pudo enviar. Revise su conexión e intente de nuevo."
msgstr "Couldn't send. Check your connection and try again."

#: static/js/results.js:29
msgid "Nota"
msgstr "Grade"

#: static/js/results.js:31
msgid "Guardar"
msgstr "Save"

#: static/js/results.js:36
msgid "Volver a la nota automática"
msgstr "Back to the automatic grade"

#: static/js/studio.js:194 static/js/studio.js:579
#, javascript-format
msgid "línea %s"
msgstr "line %s"

#: static/js/studio.js:205
msgid "validando…"
msgstr "validating…"

#: static/js/studio.js:223
msgid "sin errores"
msgstr "no errors"

#: static/js/studio.js:228
#, javascript-format
msgid "%s error"
msgid_plural "%s errores"
msgstr[0] "%s error"
msgstr[1] "%s errors"

#: static/js/studio.js:242
msgid "Corrija los errores antes de usar el panel."
msgstr "Fix the errors before using the panel."

#: static/js/studio.js:332
msgid "Título"
msgstr "Title"

#: static/js/studio.js:332
msgid "Texto con matemáticas: $f(x) = x^2$."
msgstr "Text with math: $f(x) = x^2$."

#: static/js/studio.js:335
msgid "¿Pregunta?"
msgstr "Question?"

#: static/js/studio.js:336 static/js/studio.js:341
msgid "Correcta"
msgstr "Correct"

#: static/js/studio.js:337 static/js/studio.js:342
msgid "Distractor"
msgstr "Distractor"

#: static/js/studio.js:340
msgid "Marque todas las correctas"
msgstr "Mark all the correct ones"

#: static/js/studio.js:345
msgid "Indique si cada afirmación es verdadera o falsa"
msgstr "Mark each statement as true or false"

#: static/js/studio.js:346
msgid "Afirmación verdadera"
msgstr "True statement"

#: static/js/studio.js:346
msgid "Afirmación falsa"
msgstr "False statement"

#: static/js/studio.js:349
msgid "¿Cuánto vale $2^{10}$?"
msgstr "What is $2^{10}$?"

#: static/js/studio.js:352
msgid "¿Nombre del método?"
msgstr "Name of the method?"

#: static/js/studio.js:352
msgid "bisección"
msgstr "bisection"

#: static/js/studio.js:363
msgid "Explique con sus palabras…"
msgstr "Explain in your own words…"

#: static/js/studio.js:365 static/js/studio.js:366
msgid "Criterio"
msgstr "Criterion"

#: static/js/studio.js:369
msgid "¿Qué opina?"
msgstr "What do you think?"

#: static/js/studio.js:370
msgid "Opción"
msgstr "Option"

#: static/js/studio.js:373
msgid "Con tiempo"
msgstr "Timed"

#: static/js/studio.js:379
msgid "explica el ítem anterior"
msgstr "explains the previous item"

#: static/js/studio.js:379
msgid "Explicación"
msgstr "Explanation"

#: static/js/studio.js:380
msgid "Explique aquí el desarrollo o el código de la solución."
msgstr "Explain the solution's steps or code here."

#: static/js/studio.js:383
