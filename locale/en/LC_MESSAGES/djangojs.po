msgstr "Solution slides require the policlase/v1 format."

#: static/js/studio.js:511
msgid "Opción en una línea"
msgstr "One-line option"

#: static/js/studio.js:512
msgid "Afirmación en una línea"
msgstr "One-line statement"

#: static/js/studio.js:642
msgid ""
"El texto se reemplazará por la plantilla del otro tipo. ¿Desea continuar?"
msgstr ""
"The text will be replaced with the other type's template. Do you want to "
"continue?"

#: static/js/studio.js:647
msgid "Nueva actividad"
msgstr "New activity"

#: static/js/studio.js:647
msgid "Nueva presentación"
msgstr "New presentation"

