msgstr "Correct"

#: static/js/studio.js:337 static/js/studio.js:342
msgid "Distractor"
msgstr "Distractor"

#: static/js/studio.js:340
msgid "Marque todas las correctas"
msgstr "Mark all the correct ones"

#: static/js/studio.js:345
msgid "Indique si cada afirmación es verdadera o falsa"
msgstr "Mark each statement as true or false"

#: static/js/studio.js:346
msgid "Afirmación verdadera"
msgstr "True statement"

#: static/js/studio.js:346
msgid "Afirmación falsa"
msgstr "False statement"

#: static/js/studio.js:349
msgid "¿Cuánto vale $2^{10}$?"
msgstr "What is $2^{10}$?"

#: static/js/studio.js:352
msgid "¿Nombre del método?"
msgstr "Name of the method?"

#: static/js/studio.js:352
msgid "bisección"
msgstr "bisection"

#: static/js/studio.js:363
msgid "Explique con sus palabras…"
msgstr "Explain in your own words…"

#: static/js/studio.js:365 static/js/studio.js:366
msgid "Criterio"
msgstr "Criterion"

#: static/js/studio.js:369
msgid "¿Qué opina?"
msgstr "What do you think?"

#: static/js/studio.js:370
msgid "Opción"
msgstr "Option"

#: static/js/studio.js:373
msgid "Con tiempo"
msgstr "Timed"

#: static/js/studio.js:378
msgid "Solución"
msgstr "Solution"

#: static/js/studio.js:378
msgid "Explique aquí el desarrollo o el código de la solución."
msgstr "Explain the solution's steps or code here."

#: static/js/studio.js:381
msgid "Suba la foto de su desarrollo a mano."
msgstr "Upload the photo of your handwritten work."

#: static/js/studio.js:393
msgid "Las diapositivas de solución requieren el formato policlase/v1."
msgstr "Solution slides require the policlase/v1 format."

#: static/js/studio.js:505
